<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:background="@color/black"
  >

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"


        >

        <com.gaode.demo.activity.custom.view.TmcBarView
            android:id="@+id/navi_sdk_apiTmcBarView"
            android:layout_width="18px"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="24px"
            android:layout_marginTop="3px"
            />

        <View
            android:id="@+id/navi_sdk_tmc_bar_container"
            android:layout_width="22px"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="22px"
            android:background="@drawable/lbs_navi_tmcbar_bg" />

        <ImageView
            android:id="@+id/navi_sdk_apiTmcBarCar"
            android:layout_width="22px"
            android:layout_height="22px"
            android:layout_centerHorizontal="true"
            android:layout_gravity="right"
            android:src="@drawable/lbs_navi_tmcbar_cursor" />
    </RelativeLayout>

</FrameLayout>