<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_all"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/huynew_app_bj_2"
    android:gravity="center_horizontal"
    android:orientation="vertical">


    <LinearLayout
        android:id="@+id/ll_statu_disconnect"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">


            <TextView
                android:id="@+id/tv_ble_statu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="33dp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/iv_ble_statu"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="15dp"

                android:src="@drawable/ble_is_connected"
                android:visibility="gone" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_ble_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="17dp"
            android:textColor="@color/ble_text_color"
            android:textSize="26dp" />


        <ImageView
            android:id="@+id/iv_device_pic"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:padding="6dp"
            android:visibility="gone" />


        <TextView
            android:id="@+id/tv_ble_connect_statu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="15dp"

            android:textColor="@color/ble_text_color"
            android:textSize="21dp" />


        <LinearLayout
            android:id="@+id/ll_bg_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="60dp">

            <Button
                android:id="@+id/bt_init"
                android:layout_width="178dp"
                android:layout_height="50dp"
                android:background="@drawable/bt_select"
                android:text="@string/main_init_ble"
                android:textColor="@drawable/bt_color"
                android:textSize="18dp" />

            <EditText
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="장성문,Start: 원광대학병원
end : 줄포 공업 고등학교"
                android:textColor="@color/text_translation_over_color"
                android:visibility="gone"
                android:textSize="66dp"
                />

            <Button
                android:id="@+id/bt_search"
                android:layout_width="178dp"
                android:layout_height="50dp"
                android:layout_marginTop="44dp"
                android:background="@drawable/bt_select"
                android:text="@string/main_search_ble"
                android:textColor="@drawable/bt_color"
                android:textSize="18dp" />

            <Button
                android:id="@+id/bt_now_to_navi"
                android:layout_width="178dp"
                android:layout_height="50dp"
                android:layout_marginTop="44dp"
                android:background="@drawable/bt_select"
                android:text="开始导航"
                android:textColor="@drawable/bt_color"
                android:textSize="18dp" />


        </LinearLayout>


    </LinearLayout>


    <include layout="@layout/huynew_connect_page"/>


</LinearLayout>