<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
                android:background="@drawable/hud_app_bj_6"
                android:gravity="center"
              android:orientation="vertical">


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:orientation="horizontal">


        <TextView
            android:id="@+id/tv_ble_statu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="33dp" />

        <ImageView
            android:id="@+id/iv_ble_statu"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginLeft="15dp"
            android:layout_gravity="center_vertical"

            android:visibility="gone"
            android:src="@drawable/ble_is_connected"
            />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_ble_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/ble_text_color"
        android:paddingTop="17dp"
        android:textSize="26dp"
     />


    <ImageView
        android:id="@+id/iv_device_pic"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:padding="6dp"
        android:visibility="gone"/>


    <TextView
        android:id="@+id/tv_ble_connect_statu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="15dp"

        android:textColor="@color/ble_text_color"
        android:textSize="21dp"
        />


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="88px"

        android:orientation="horizontal">
        <Button
            android:id="@+id/bt_app_set"
            android:layout_width="178dp"
            android:layout_height="50dp"
            android:textSize="18dp"
            android:background="@drawable/bt_select"
            android:textColor="@drawable/bt_color"
            android:text="app设置" />



        <Button
            android:id="@+id/bt_map_set"
            android:layout_width="178dp"
            android:layout_height="50dp"
            android:textSize="18dp"
            android:background="@drawable/bt_select"
            android:textColor="@drawable/bt_color"
            android:layout_marginLeft="46dp"
            android:text="地图设置"/>

    </LinearLayout>


    <LinearLayout
        android:id="@+id/ll_bg_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="60dp"
        android:gravity="center"
        android:orientation="vertical">
        <Button
            android:id="@+id/bt_init"
            android:layout_width="178dp"
            android:layout_height="50dp"
            android:textSize="18dp"
            android:background="@drawable/bt_select"
            android:textColor="@drawable/bt_color"
            android:text="@string/main_init_ble"/>

        <Button
            android:id="@+id/bt_search"
            android:layout_width="178dp"
            android:layout_height="50dp"
            android:layout_marginTop="44dp"
            android:textSize="18dp"
            android:background="@drawable/bt_select"
            android:textColor="@drawable/bt_color"
            android:text="@string/main_search_ble" />


    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_bg_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="80dp"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/bt_ble_set"
                android:layout_width="178dp"
                android:layout_height="50dp"
                android:textSize="18dp"
                android:background="@drawable/bt_select"
                android:textColor="@drawable/bt_color"
                android:text="@string/main_set_ble"/>

            <Button
                android:id="@+id/bt_to_gaode_t"
                android:layout_width="178dp"
                android:layout_height="50dp"
                android:textSize="18dp"
                android:background="@drawable/bt_select"
                android:textColor="@drawable/bt_color"
                android:layout_marginLeft="46dp"
                android:text="用户设置"/>


        </LinearLayout>


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="88px"
            android:orientation="horizontal">
            <Button
                android:id="@+id/bt_send_test"
                android:layout_width="178dp"
                android:layout_height="50dp"
                android:textSize="18dp"
                android:background="@drawable/bt_select"
                android:textColor="@drawable/bt_color"

                android:text="@string/main_send_ble_test_data" />



            <Button
                android:id="@+id/bt_to_gaode_demo"
                android:layout_width="178dp"
                android:layout_height="50dp"
                android:textSize="18dp"
                android:background="@drawable/bt_select"
                android:textColor="@drawable/bt_color"

                android:layout_marginLeft="46dp"
                android:text="GaoDe Demo"/>

        </LinearLayout>





    </LinearLayout>






</LinearLayout>