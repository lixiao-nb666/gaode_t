<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_welcome_bj"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hud_app_bj_1"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="3"
        android:gravity="center_horizontal|bottom"
        android:orientation="vertical">

        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="地图 | HUD"
            android:textColor="@color/black"
            android:textSize="60dp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="HEAD UP DISPLAY"
            android:textSize="28dp"
            android:textStyle="bold" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="抬头显示"
            android:textSize="44dp"
            android:textStyle="bold" />
    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="4"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="90dp"
            android:layout_height="80dp"
            android:src="@drawable/icon_gaode" />

        <ImageView
            android:layout_width="53dp"
            android:layout_height="25dp"
            android:layout_marginLeft="38dp"
            android:layout_marginRight="33dp"
            android:src="@drawable/hud_a_to_b" />

        <ImageView
            android:id="@+id/iv_hud_device"
            android:layout_width="175dp"
            android:layout_height="175dp" />

    </LinearLayout>


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="3"
  >


        <LinearLayout
            android:id="@+id/ll_ts_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="让连接更简单，让生活更美好"
                android:textSize="24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="为了安全，请停车时操作手机。"
                android:textColor="@color/black"
                android:textSize="29dp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="注意前方，预防发生交通事故。"
                android:textColor="@color/black"
                android:textSize="29dp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_ts_2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_err_show"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22dp" />

            <Button
                android:id="@+id/bt_get_permissions"
                android:layout_width="158dp"
                android:layout_height="44dp"
                android:background="@drawable/welcome_select"
                android:textColor="@drawable/welcome_color"
                android:layout_marginTop="5dp"
                android:textSize="16dp"
                android:text=">>>>Go>>>>"/>

            <Button
                android:id="@+id/bt_get_file_permission"
                android:layout_width="158dp"
                android:layout_height="44dp"
                android:background="@drawable/welcome_select"
                android:textColor="@drawable/welcome_color"
                android:layout_marginTop="5dp"
                android:text=">>>>Go>>>>"
                android:textSize="16dp"/>

            <Button
                android:id="@+id/bt_get_battery_permission"
                android:layout_width="158dp"
                android:layout_height="44dp"
                android:background="@drawable/welcome_select"
                android:textColor="@drawable/welcome_color"
                android:layout_marginTop="5dp"
                android:text=">>>>Go>>>>"
                android:textSize="16dp"/>


        </LinearLayout>



    </FrameLayout>


</LinearLayout>