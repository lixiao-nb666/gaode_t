<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="37dp"
        android:textSize="29dp"
        android:textColor="@color/text_translation_over_color"
        android:text="@string/set_page"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:orientation="vertical">

        <Button
            android:id="@+id/bt_add_lang"
            android:layout_width="435dp"
            android:layout_height="56dp"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="7dp"
            android:text="@string/add_language"
            android:textColor="@color/white"
            android:background="@drawable/select_item"/>
        <Button
            android:id="@+id/bt_delect_lang"
            android:layout_width="435dp"
            android:layout_height="56dp"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="7dp"
            android:text="@string/delect_language"
            android:textColor="@color/white"
            android:background="@drawable/select_item"/>
        <Button
            android:id="@+id/bt_check_version"
            android:layout_width="435dp"
            android:layout_height="56dp"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="7dp"
            android:text="@string/check_version"
            android:textColor="@color/white"
            android:background="@drawable/select_item"/>

    </LinearLayout>
</RelativeLayout>