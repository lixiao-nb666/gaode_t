<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="@drawable/hud_app_bj_2"
              >


        <TextView
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:textColor="@color/text_translation_over_color"
            android:textSize="60dp"
            android:text="文件传输"/>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25dp"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

                <Button
                    android:id="@+id/bt_open_hotspot"
                    android:layout_width="110dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:background="@drawable/select_item"
                    android:textColor="@color/white"
                    android:textSize="22dp"
                    android:text="打开热点"/>

                <Button
                    android:id="@+id/bt_close_hotspot"
                    android:layout_width="110dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:background="@drawable/select_item"
                    android:textColor="@color/white"
                    android:textSize="22dp"
                    android:text="关闭热点"/>


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_marginLeft="25dp"
            android:layout_marginRight="25dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_file_doc_show"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="请按指示操作："
                    android:textColor="@color/white"
                    android:textSize="25dp"/>

                <LinearLayout
                    android:id="@+id/ll_go_url"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:visibility="gone"
                    android:orientation="vertical">

                        <TextView

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="任意智能设备都可直接连接上述热点\n然后访问以下地址下载文件"
                            android:textColor="@color/white"
                            android:textSize="27dp"/>

                        <TextView

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="http://192.168.31.1/files/"
                            android:textColor="@color/white"
                            android:textSize="27dp"/>

                        <Button
                            android:id="@+id/bt_go_file_url"
                            android:layout_width="110dp"
                            android:layout_height="40dp"
                            android:layout_marginLeft="4dp"
                            android:layout_marginRight="4dp"
                            android:background="@drawable/select_item"
                            android:textColor="@color/text_translation_over_color"
                            android:textSize="22dp"
                            android:layout_marginTop="18dp"
                            android:text="GO"/>

                </LinearLayout>





        </LinearLayout>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center"
            android:text="深圳市MyW软件团队"
            android:textColor="@color/text_translation_over_color"
            android:textSize="33dp"/>

</LinearLayout>