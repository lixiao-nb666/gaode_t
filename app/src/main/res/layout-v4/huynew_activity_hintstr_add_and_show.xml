<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
                android:orientation="vertical"
    android:background="@drawable/huynew_app_bj_1"
              >


        <EditText
            android:id="@+id/et_title"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:textColor="@color/text_translation_over_color"
            android:lines="1"
            android:textSize="44dp"
            android:hint="请添加标题"
            android:textColorHint="@color/white"
           />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginLeft="15dp"
            android:orientation="horizontal">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_hint_str"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="4"
                />
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="38dp"
                    android:layout_marginBottom="38dp"
                    android:background="@color/text_translation_over_color"/>
                <EditText
                    android:id="@+id/et_hint_str"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="5"
                    android:gravity="top"
                    android:textColor="@color/text_translation_over_color"
                    android:textSize="27dp"
                    android:textColorHint="@color/white"
                    android:hint="请输入内容" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_now_show_play_hint_str"
            android:layout_width="420dp"
            android:layout_height="210dp"
            android:layout_gravity="center_horizontal"
            android:visibility="gone"
            android:background="@color/black"
            android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_last_hint_str"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="4"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:textSize="20dp"/>
                <TextView
                    android:id="@+id/tv_now_hint_str"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="5"
                    android:gravity="center"
                    android:textColor="@color/text_translation_over_color"
                    android:textSize="25dp"/>

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginLeft="15dp"
            android:orientation="horizontal">
                <TextView

                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="4"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="33dp"

                    android:text="展示区域"
                    />

                <TextView

                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="5"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="30dp"

                    android:text="输入区域" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">
                <Button
                    android:id="@+id/bt_replay"
                    android:layout_width="80dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:background="@drawable/select_item"
                    android:textColor="@color/white"
                    android:textSize="22dp"
                    android:text="重播"/>
                <Button
                    android:id="@+id/bt_pause"
                    android:layout_width="80dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:background="@drawable/select_item"
                    android:textColor="@color/white"
                    android:textSize="22dp"
                    android:text="暂停"/>
                <Button
                    android:id="@+id/bt_play"
                    android:layout_width="80dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:background="@drawable/select_item"
                    android:textColor="@color/white"
                    android:textSize="22dp"
                    android:text="播放"/>

                <Button
                    android:id="@+id/bt_delete"
                    android:layout_width="80dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:background="@drawable/select_item"
                    android:textColor="@color/white"
                    android:textSize="22dp"
                    android:text="删除"/>

                <Button
                    android:id="@+id/bt_clear"
                    android:layout_width="80dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:background="@drawable/select_item"
                    android:textColor="@color/white"
                    android:textSize="22dp"
                    android:text="清空"/>

                <Button
                    android:id="@+id/bt_share"
                    android:layout_width="80dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:background="@drawable/select_item"
                    android:textColor="@color/white"
                    android:textSize="22dp"
                    android:text="保存"/>



        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                        android:layout_weight="1">
                        <ImageView
                            android:id="@+id/iv_change_play_speed_mold"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:padding="8dp"
                            android:src="@drawable/icon_update"/>

                        <TextView
                            android:id="@+id/tv_play_speed_mold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="28dp"
                            android:textColor="@color/white"
                            android:text="自动模式"/>
                        <LinearLayout
                            android:id="@+id/ll_play_speed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal">
                                <ImageView
                                    android:id="@+id/iv_reduce_play_speed"
                                    android:layout_width="60dp"
                                    android:layout_height="60dp"
                                    android:padding="16dp"
                                    android:src="@drawable/icon_reduce"/>

                                <TextView
                                    android:id="@+id/tv_play_speed"
                                    android:layout_width="wrap_content"
                                    android:textSize="28dp"
                                    android:textColor="@color/white"
                                    android:layout_height="wrap_content" />
                                <ImageView
                                    android:id="@+id/iv_add_play_speed"
                                    android:layout_width="60dp"
                                    android:layout_height="60dp"
                                    android:padding="16dp"
                                    android:src="@drawable/icon_add"/>
                        </LinearLayout>

                </LinearLayout>
                <Button
                    android:id="@+id/bt_exit"
                    android:layout_width="120dp"
                    android:layout_height="60dp"
                    android:layout_marginLeft="6dp"
                    android:layout_marginRight="16dp"
                    android:background="@drawable/select_item"
                    android:textColor="@color/white"
                    android:textSize="33dp"
                    android:text="退出"/>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center"
            android:text="深圳市MyW软件团队"
            android:textColor="@color/text_translation_over_color"
            android:textSize="33dp"/>

</LinearLayout>