<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
                android:orientation="vertical"
    android:background="@drawable/hud_app_bj_2"
              >


        <TextView
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:textColor="@color/text_translation_over_color"
            android:textSize="60dp"
            android:text="相机功能"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25dp"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

                <Button
                    android:id="@+id/bt_take_video"
                    android:layout_width="110dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:background="@drawable/select_item"
                    android:textColor="@color/white"
                    android:textSize="22dp"
                    android:text="录像开始"/>

                <Button
                    android:id="@+id/bt_take_video_over"
                    android:layout_width="110dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:background="@drawable/select_item"
                    android:textColor="@color/white"
                    android:textSize="22dp"
                    android:text="停止 录像"/>

                <Button
                    android:id="@+id/bt_take_picture"
                    android:layout_width="110dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:background="@drawable/select_item"
                    android:textColor="@color/white"
                    android:textSize="22dp"
                    android:text="拍照"/>


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_marginLeft="25dp"
            android:layout_marginRight="25dp"
            android:layout_marginTop="30dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_camera_doc_show"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="请按指示操作："
                    android:textColor="@color/white"
                    android:textSize="25dp"/>

                <LinearLayout
                    android:id="@+id/ll_go_url"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">



                        <TextView

                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="下载视频/相片"
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:textSize="27dp"/>

                        <Button
                            android:id="@+id/bt_go_file_activity"
                            android:layout_width="110dp"
                            android:layout_height="40dp"
                            android:layout_marginLeft="4dp"
                            android:layout_marginRight="4dp"
                            android:background="@drawable/select_item"
                            android:textColor="@color/text_translation_over_color"
                            android:layout_marginTop="18dp"
                            android:textSize="22dp"
                            android:text="GO"/>

                </LinearLayout>





        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center"
            android:text="深圳市MyW软件团队"
            android:textColor="@color/text_translation_over_color"
            android:textSize="33dp"/>

</LinearLayout>